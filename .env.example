# Supabase Configuration
# Obtenir ces valeurs depuis : https://supabase.com/dashboard → Settings → API

# URL de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé publique anonyme Supabase (safe pour le client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT:
# 1. Copier ce fichier vers .env.local
# 2. Remplacer les valeurs par vos vraies clés Supabase
# 3. Ne JAMAIS commit .env.local dans Git
