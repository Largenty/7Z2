# Supabase Configuration
# Obtenir ces valeurs depuis : https://supabase.com/dashboard → Settings → API

# URL de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé publique anonyme Supabase (safe pour le client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# URL du site (pour SEO et Open Graph)
# En développement : http://localhost:3000
# En production : https://votre-domaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Utiliser l'Edge Function pour la validation des scores
# false = Insertion directe (développement, moins sécurisé)
# true = Edge Function (production, sécurisé avec validation)
# En développement local : false (l'Edge Function n'est pas déployée localement)
# En production Vercel : true (après avoir déployé l'Edge Function sur Supabase)
NEXT_PUBLIC_USE_EDGE_FUNCTION=false

# IMPORTANT:
# 1. Copier ce fichier vers .env.local
# 2. Remplacer les valeurs par vos vraies clés
# 3. Ne JAMAIS commit .env.local dans Git
# 4. Sur Vercel/production, configurer ces variables dans le dashboard
#    et mettre NEXT_PUBLIC_USE_EDGE_FUNCTION=true
